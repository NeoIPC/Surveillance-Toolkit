.Rproj.user
.Rhistory
.RData
.Ruserdata
.quarto
# Auto-generated by Quarto's Lua tooling when the toolkit is opened in
# an editor — pins absolute Quarto install paths, must not be committed.
/.luarc.json
*.aux
*.log
artifacts
build
doc/protocol/NeoIPC-Antibiotics*.adoc
doc/protocol/NeoIPC-Infectious-Agents*.adoc
doc/protocol/NeoIPC-Core-Protocol*.xml
doc/protocol/img/NeoIPC-Core-Decision-Flow*.svg
doc/protocol/img/NeoIPC-Core-Master-Data-Collection-Sheet-Image*.svg
doc/protocol/img/NeoIPC-Core-Master-Data-Collection-Sheet*.svg
doc/protocol/img/NeoIPC-Core-Title-Page*.svg
doc/protocol/img/Preview-Watermark*.svg
glossary.*.yaml
metadata/common/infectious-agents/NeoIPC-Infectious-Agents.*.yaml
metadata/common/infectious-agents/Output-Footer.*.adoc
metadata/common/infectious-agents/Output-Header.*.adoc
# Rendered metadata distribution packages — generated build artifacts (CI artifact + Release asset), never committed.
metadata/dist/*.json
output/
reports/**/*.html
reports/**/*.md
reports/**/*_files/**
reports/**/_output
# Rendered documentation — the sources under docs/ are Markdown; anything Quarto or Pandoc produces
# beside them is build output. Note the asymmetry with reports/ above, which also ignores *.md: here the
# .md files ARE the source and must stay tracked.
docs/*.html
docs/*_files/
reports/ICHE-Health-Intervention-Codes.csv
data/
# Provisioned (not committed) DocumentFormat.OpenXml assemblies for the data-dictionary .xlsx writer
# (restored by `dotnet publish` of lib/NeoIPC-Tools.Dependencies.csproj; see that file + the data-dictionary README).
scripts/modules/NeoIPC-Tools/lib/bin/
scripts/modules/NeoIPC-Tools/lib/obj/
# Pester -CI test report (NUnit XML) — a transient run artifact, never committed.
testResults.xml
# Python bytecode caches, created wherever the scripts or their tests are run.
__pycache__/
.pytest_cache/
# Scratch / throwaway artifacts, never committed (the durable procedures live in the relevant READMEs).
/tmp/

# Localized figure text, written by po4a from common/figure-strings.yaml on every run.
common/figure-strings.*.yaml
