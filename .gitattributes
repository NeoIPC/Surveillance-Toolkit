# DHIS2 expression files (the metadata directory's externalised program-rule conditions, action data, program-
# indicator / validation-rule expressions) are LF text — pin the line endings so they round-trip byte-for-byte
# regardless of a checkout machine's core.autocrlf setting.
*.dhis2 text eol=lf

# Translation catalogues are machine-maintained: the .pot files are generated by po4a and the export
# scripts, and the .po files are written exclusively by Weblate. Marking them generated collapses them
# by default in review UIs and keeps them out of language statistics. They are still diffable on demand.
po/*.pot linguist-generated=true
po/*.po linguist-generated=true
scripts/po/*.po linguist-generated=true
