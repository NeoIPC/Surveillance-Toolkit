# Line endings are LF everywhere, by repository contract rather than by machine configuration.
#
# Without this file the result depends on each developer's core.autocrlf, whose Git-for-Windows
# installer default is `true` — that checks text files out as CRLF, and every tool that then reads
# and rewrites one carries the CRLF back in. Declaring it here makes the outcome the same on every
# checkout: normalize to LF on commit, and write LF into the working tree on checkout.
#
# Note what this does NOT do: `text=auto` normalizes on commit, so a tool that writes CRLF into the
# working tree still yields a clean `git status` and an LF blob in the index. That is why the writers
# in this repository are pinned to LF individually, and why the text-hygiene check inspects the
# working-tree column of `git ls-files --eol` rather than the index column — an index-only check can
# never fail here, however the working tree looks.
* text=auto eol=lf

# Binary files must never be touched by end-of-line conversion. `text=auto` guesses from content and
# is usually right, but a file it misclassifies is corrupted rather than merely reformatted, so the
# formats actually stored in this repository are declared explicitly.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.zip   binary
*.gz    binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mo    binary

# DHIS2 expression files (the metadata directory's externalised program-rule conditions, action data,
# program-indicator / validation-rule expressions) must round-trip byte-for-byte. Declared `text`
# unconditionally rather than left to the `text=auto` above: `auto` guesses from content, so a file
# that ever contained a NUL byte would be treated as binary and silently lose the eol guarantee.
# These are known to be text, so say so outright.
*.dhis2 text eol=lf

# Translation catalogues are machine-maintained: the .pot files are generated by po4a and the export
# scripts, and the .po files are written by Weblate — except po/glossary.*.po and scripts/po/*.po,
# which are not registered as Weblate components and stay repository-owned. Marking them generated
# collapses them by default in review UIs and keeps them out of language statistics. They are still
# diffable on demand.
po/*.pot linguist-generated=true
po/*.po linguist-generated=true
scripts/po/*.po linguist-generated=true
